generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  name           String?
  image          String?
  githubId       String?       @unique
  githubUsername String?
  registrations  Registration[] // Websites this user is registered in
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum AdminRole {
  OWNER
  MEMBER
}

model Admin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  fullname  String
  websites  Website[] // Legacy relation for backward compatibility
  hackathons AdminHackathon[] // Many-to-many with Hackathon
  onboardingCompleted Boolean @default(false)
  entitlementClaims ParticipantEntitlement[] // Entitlement claims made by this admin
  judgeProfiles  Judge[]  // Admin can be a judge in multiple hackathons
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Hackathon {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  joinCode    String           @unique  // Unique code for joining
  websiteId   Int?             @unique // Optional link to Website builder
  website     Website?         @relation(fields: [websiteId], references: [id])
  admins      AdminHackathon[] // Many-to-many with Admin
  registrations Registration[] // Participants registered to this hackathon (optional)
  mentors     Mentor[]         // Mentors for this hackathon
  judges      Judge[]          // Judges for this hackathon
  projects    Project[]        // Projects submitted for this hackathon
  judgingCriteria JudgingCriteria[] // Judging criteria/rubrics
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([joinCode])
}

model AdminHackathon {
  id          Int       @id @default(autoincrement())
  adminId     Int
  hackathonId Int
  role        AdminRole @default(OWNER)  // OWNER or MEMBER
  joinedAt    DateTime  @default(now())

  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([adminId, hackathonId])
  @@index([adminId])
  @@index([hackathonId])
}
model Website {
  id          Int           @id @default(autoincrement())
  slug        String        @unique  // Unique URL identifier (e.g., "techfest-2024")
  title       String                 // Website/Hackathon title
  description String?                // Optional description

  // Website builder data stored as JSON
  websiteData Json                   // Stores all the builder configuration

  // Ownership & permissions (keeping for backward compatibility)
  adminId     Int?                   // Foreign key to Admin (nullable for new hackathon system)
  admin       Admin?         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Link to Hackathon (optional - for new hackathon system)
  hackathon   Hackathon?             // The hackathon this website belongs to

  // User registrations (legacy - now linked to Hackathon)
  registrations Registration[]       // Users registered in this website (optional)

  // Mentors for this hackathon
  mentors     Mentor[]               // Mentors assigned to this hackathon

  // Entitlements for this hackathon
  entitlements Entitlement[]

  // Status management
  status      WebsiteStatus @default(DRAFT)  // DRAFT or PUBLISHED

  // Publication info
  publishedAt DateTime?              // When it was published
  viewCount   Int           @default(0)  // Track views (optional)

  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([adminId])
  @@index([status])
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

// Junction table for User-Hackathon registration relationship
model Registration {
  id          Int      @id @default(autoincrement())
  userId      Int
  hackathonId Int?     // Primary link to hackathon (new system) - optional for migration
  websiteId   Int?     // Legacy link to website (backward compatibility)

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  website     Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Registration metadata
  registeredAt DateTime @default(now())
  status      RegistrationStatus @default(PENDING)

  // QR Code identifier for entitlement verification
  qrIdentifier String? @unique // Generated when participant is approved

  // Entitlement claims for this registration
  entitlements ParticipantEntitlement[]

  // Project submitted by this registration (optional)
  project     Project?

  // Unique constraint on userId + hackathonId (when hackathonId is set)
  @@index([userId])
  @@index([hackathonId])
  @@index([websiteId])
  @@index([qrIdentifier])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Mentor model for hackathon mentors
model Mentor {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  image       String?           // Profile photo URL
  title       String?           // e.g., "Senior Engineer at Google"
  bio         String?           // Short bio/description
  expertise   String[]          // Array of expertise areas: ["AI/ML", "Web Development"]
  linkedin    String?           // LinkedIn URL
  github      String?           // GitHub username

  // Link to hackathon (new - primary)
  hackathonId Int?
  hackathon   Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  // Link to website (legacy - keep for backward compatibility)
  websiteId   Int
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Status
  status      MentorStatus @default(ACTIVE)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hackathonId])
  @@index([websiteId])
}

enum MentorStatus {
  ACTIVE
  INACTIVE
}

// Entitlement types for a hackathon (e.g., Breakfast, Lunch, Certificate)
model Entitlement {
  id          Int                   @id @default(autoincrement())
  name        String                // e.g., "Breakfast", "Lunch", "Certificate"
  description String?
  websiteId   Int                   // Link to hackathon
  website     Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Track which participants received this entitlement
  claims      ParticipantEntitlement[]

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([name, websiteId]) // Prevent duplicate entitlement names per hackathon
  @@index([websiteId])
}

// Junction table tracking entitlement claims
model ParticipantEntitlement {
  id             Int           @id @default(autoincrement())
  registrationId Int
  entitlementId  Int

  // Relations
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  entitlement    Entitlement   @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  // Claim metadata
  claimedAt      DateTime      @default(now())
  claimedBy      Int           // Admin ID who verified/scanned
  admin          Admin         @relation(fields: [claimedBy], references: [id])

  // Each participant can claim each entitlement only once
  @@unique([registrationId, entitlementId])
  @@index([registrationId])
  @@index([entitlementId])
}

// ============================================
// JUDGING SYSTEM MODELS
// ============================================

// Judging Criteria/Rubric defined by organizers
model JudgingCriteria {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., "Innovation", "Technical Complexity"
  description String?
  maxScore    Int       @default(10)  // Maximum score for this criteria
  weight      Float     @default(1.0) // Weight for weighted scoring
  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  scores      Score[]
  order       Int       @default(0)   // Display order

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([hackathonId])
  @@unique([name, hackathonId])
}

// Judge assignment to hackathon
model Judge {
  id          Int       @id @default(autoincrement())
  adminId     Int       // Link to Admin user (judges are admins with judge role)
  hackathonId Int
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  // Project assignments for this judge
  assignments JudgeAssignment[]

  createdAt   DateTime  @default(now())

  @@unique([adminId, hackathonId])
  @@index([hackathonId])
  @@index([adminId])
}

// Project model - teams submit projects for hackathons
model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  repoUrl     String?   // GitHub repository link
  demoUrl     String?   // Live demo URL
  presentationUrl String? // Presentation file link
  videoUrl    String?   // Demo video link

  // Team info
  teamName    String
  teamMembers String[]  // Array of participant emails/names
  teamLeaderEmail String? // Contact email for team leader

  hackathonId Int
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  // Registration link (optional - project submitted by registered participant)
  registrationId Int? @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  // Judge assignments
  assignments   JudgeAssignment[]

  status      ProjectStatus @default(SUBMITTED)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hackathonId])
  @@index([status])
  @@index([teamName])
}

enum ProjectStatus {
  DRAFT        // Still being worked on
  SUBMITTED    // Submitted for review
  UNDER_REVIEW // Being evaluated by judges
  JUDGED       // Evaluation complete
  FINALIST     // Selected as finalist
  WINNER       // Won the hackathon
}

// Judge-Project assignment
model JudgeAssignment {
  id        Int       @id @default(autoincrement())
  judgeId   Int
  projectId Int

  judge     Judge     @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Track evaluation status
  isCompleted Boolean @default(false)
  completedAt DateTime?

  // Scores given by this judge for this project
  scores    Score[]

  createdAt DateTime @default(now())

  @@unique([judgeId, projectId])
  @@index([judgeId])
  @@index([projectId])
}

// Individual score for a criteria by a judge
model Score {
  id             Int       @id @default(autoincrement())
  judgeAssignmentId Int
  criteriaId     Int

  score          Int       // Actual score given
  feedback       String?   // Optional feedback comment

  judgeAssignment JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)
  criteria        JudgingCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([judgeAssignmentId, criteriaId])
  @@index([judgeAssignmentId])
  @@index([criteriaId])
}