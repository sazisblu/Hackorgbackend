generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  name           String?
  image          String?
  githubId       String?       @unique
  githubUsername String?
  registrations  Registration[] // Websites this user is registered in
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum AdminRole {
  OWNER
  MEMBER
}

model Admin {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  fullname  String
  websites  Website[] // Legacy relation for backward compatibility
  hackathons AdminHackathon[] // Many-to-many with Hackathon
  onboardingCompleted Boolean @default(false)
  entitlementClaims ParticipantEntitlement[] // Entitlement claims made by this admin
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Hackathon {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  joinCode    String           @unique  // Unique code for joining
  websiteId   Int?             @unique // Optional link to Website builder
  website     Website?         @relation(fields: [websiteId], references: [id])
  admins      AdminHackathon[] // Many-to-many with Admin
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([joinCode])
}

model AdminHackathon {
  id          Int       @id @default(autoincrement())
  adminId     Int
  hackathonId Int
  role        AdminRole @default(OWNER)  // OWNER or MEMBER
  joinedAt    DateTime  @default(now())

  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([adminId, hackathonId])
  @@index([adminId])
  @@index([hackathonId])
}
model Website {
  id          Int           @id @default(autoincrement())
  slug        String        @unique  // Unique URL identifier (e.g., "techfest-2024")
  title       String                 // Website/Hackathon title
  description String?                // Optional description

  // Website builder data stored as JSON
  websiteData Json                   // Stores all the builder configuration

  // Ownership & permissions (keeping for backward compatibility)
  adminId     Int?                   // Foreign key to Admin (nullable for new hackathon system)
  admin       Admin?         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Link to Hackathon (optional - for new hackathon system)
  hackathon   Hackathon?             // The hackathon this website belongs to

  // User registrations
  registrations Registration[]       // Users registered in this website

  // Mentors for this hackathon
  mentors     Mentor[]               // Mentors assigned to this hackathon

  // Entitlements for this hackathon
  entitlements Entitlement[]

  // Status management
  status      WebsiteStatus @default(DRAFT)  // DRAFT or PUBLISHED

  // Publication info
  publishedAt DateTime?              // When it was published
  viewCount   Int           @default(0)  // Track views (optional)

  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([adminId])
  @@index([status])
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}

// Junction table for User-Website many-to-many relationship
model Registration {
  id          Int      @id @default(autoincrement())
  userId      Int
  websiteId   Int

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Registration metadata
  registeredAt DateTime @default(now())
  status      RegistrationStatus @default(PENDING)

  // QR Code identifier for entitlement verification
  qrIdentifier String? @unique // Generated when participant is approved

  // Entitlement claims for this registration
  entitlements ParticipantEntitlement[]

  // Make sure a user can only register once per website
  @@unique([userId, websiteId])
  @@index([userId])
  @@index([websiteId])
  @@index([qrIdentifier])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Mentor model for hackathon mentors
model Mentor {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  image       String?           // Profile photo URL
  title       String?           // e.g., "Senior Engineer at Google"
  bio         String?           // Short bio/description
  expertise   String[]          // Array of expertise areas: ["AI/ML", "Web Development"]
  linkedin    String?           // LinkedIn URL
  github      String?           // GitHub username

  // Link to website (hackathon)
  websiteId   Int
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Status
  status      MentorStatus @default(ACTIVE)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([websiteId])
}

enum MentorStatus {
  ACTIVE
  INACTIVE
}

// Entitlement types for a hackathon (e.g., Breakfast, Lunch, Certificate)
model Entitlement {
  id          Int                   @id @default(autoincrement())
  name        String                // e.g., "Breakfast", "Lunch", "Certificate"
  description String?
  websiteId   Int                   // Link to hackathon
  website     Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Track which participants received this entitlement
  claims      ParticipantEntitlement[]

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([name, websiteId]) // Prevent duplicate entitlement names per hackathon
  @@index([websiteId])
}

// Junction table tracking entitlement claims
model ParticipantEntitlement {
  id             Int           @id @default(autoincrement())
  registrationId Int
  entitlementId  Int

  // Relations
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  entitlement    Entitlement   @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  // Claim metadata
  claimedAt      DateTime      @default(now())
  claimedBy      Int           // Admin ID who verified/scanned
  admin          Admin         @relation(fields: [claimedBy], references: [id])

  // Each participant can claim each entitlement only once
  @@unique([registrationId, entitlementId])
  @@index([registrationId])
  @@index([entitlementId])
}